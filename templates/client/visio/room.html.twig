{#
 # The video room (Base\Office\Controller\Client\VisioController::room): the
 # camera check, the waiting room, the call. public/js/visio.js does the
 # rest - RTCPeerConnection, the handshake over HTTP, the chat on a data
 # channel. Without scripts, or before the room opens, the page says when.
 #}
{% extends office_layout() %}

{% block title %}{{ 'visio.title'|trans({}, 'office') }}{% endblock %}

{% block content %}
<section class="of-page of-visio"
    {% if open %}
    data-office-visio
    data-role="{{ is_host ? 'host' : 'guest' }}"
    data-ice-url="{{ path('office_visio_ice', {token: room.token}) }}"
    data-signal-url="{{ path('office_visio_signal_send', {token: room.token}) }}"
    data-end-url="{{ path('office_visio_end', {token: room.token}) }}"
    data-document-url="{{ path('office_visio_document', {token: room.token}) }}"
    data-csrf="{{ csrf_token('office_visio_' ~ room.token) }}"
    {% endif %}>
    <header class="of-page-head">
        <h1>{{ 'visio.title'|trans({}, 'office') }}</h1>
        <p class="of-lead">{{ (is_host ? 'visio.with_guest' : 'visio.with_host')|trans({name: office_person(is_host ? room.guest : room.host)}, 'office') }}</p>
    </header>

    {% block visio_notice %}{% endblock %}

    {% if room.endedAt %}
    <p class="of-notice" role="status">{{ 'visio.ended'|trans({}, 'office') }}</p>
    {% elseif early %}
    <p class="of-notice" role="status">{{ 'visio.early'|trans({time: room.opensAt|format_datetime('none', 'short', locale=app.request.locale, timezone=office_timezone())}, 'office') }}</p>
    {% elseif not open %}
    <p class="of-notice" role="status">{{ 'visio.closed'|trans({}, 'office') }}</p>
    {% else %}
    <noscript><p class="of-warning">{{ 'visio.noscript'|trans({}, 'office') }}</p></noscript>

    <p class="of-visio-status" data-visio-status role="status" aria-live="polite">{{ 'visio.status.check'|trans({}, 'office') }}</p>

    <div class="of-visio-stage">
        <video class="of-visio-remote" data-visio-remote autoplay playsinline aria-label="{{ 'visio.remote'|trans({}, 'office') }}"></video>
        <video class="of-visio-local" data-visio-local autoplay playsinline muted aria-label="{{ 'visio.local'|trans({}, 'office') }}"></video>
    </div>

    <div class="of-visio-controls" role="toolbar" aria-label="{{ 'visio.controls'|trans({}, 'office') }}">
        <button type="button" class="of-button" data-visio-join hidden>{{ (is_host ? 'visio.start' : 'visio.enter')|trans({}, 'office') }}</button>
        <button type="button" class="of-button of-button-quiet" data-visio-mic aria-pressed="false" hidden>{{ 'visio.mic'|trans({}, 'office') }}</button>
        <button type="button" class="of-button of-button-quiet" data-visio-camera aria-pressed="false" hidden>{{ 'visio.camera'|trans({}, 'office') }}</button>
        <button type="button" class="of-button of-button-quiet" data-visio-screen aria-pressed="false" hidden>{{ 'visio.screen'|trans({}, 'office') }}</button>
        <label class="of-button of-button-quiet" data-visio-file-label hidden>{{ 'visio.file'|trans({}, 'office') }}<input type="file" data-visio-file class="of-sr" accept="application/pdf,image/*"></label>
        <button type="button" class="of-button of-button-danger" data-visio-hangup hidden>{{ (is_host ? 'visio.end' : 'visio.leave')|trans({}, 'office') }}</button>
    </div>

    <section class="of-visio-chat" aria-labelledby="of-visio-chat-title" data-visio-chat hidden>
        <h2 id="of-visio-chat-title">{{ 'visio.chat'|trans({}, 'office') }}</h2>
        <ol class="of-visio-messages" data-visio-messages aria-live="polite"></ol>
        <form data-visio-chat-form class="of-visio-chat-form">
            <label class="of-sr" for="of-visio-input">{{ 'visio.chat_label'|trans({}, 'office') }}</label>
            <input id="of-visio-input" type="text" maxlength="1000" autocomplete="off" data-visio-input>
            <button type="submit" class="of-button of-button-small">{{ 'visio.chat_send'|trans({}, 'office') }}</button>
        </form>
        <p class="of-help">{{ 'visio.chat_help'|trans({}, 'office') }}</p>
    </section>

    <script type="application/json" data-visio-texts>{{ {
        check: 'visio.status.check'|trans({}, 'office'),
        ready: 'visio.status.ready'|trans({}, 'office'),
        denied: 'visio.status.denied'|trans({}, 'office'),
        waiting_host: 'visio.status.waiting_host'|trans({}, 'office'),
        waiting_guest: 'visio.status.waiting_guest'|trans({}, 'office'),
        guest_here: 'visio.status.guest_here'|trans({}, 'office'),
        connecting: 'visio.status.connecting'|trans({}, 'office'),
        connected: 'visio.status.connected'|trans({}, 'office'),
        lost: 'visio.status.lost'|trans({}, 'office'),
        ended: 'visio.ended'|trans({}, 'office'),
        file_sent: 'visio.file_sent'|trans({}, 'office'),
        file_received: 'visio.file_received'|trans({}, 'office'),
        you: 'visio.you'|trans({}, 'office')
    }|json_encode|raw }}</script>
    <script src="{{ asset('bundles/office/js/visio.js') }}" defer></script>
    {% endif %}
</section>
{% endblock %}
