{# The contact form (Base\Office\Controller\Client\OfficeController::contact): omnibase's ContactType, the regime's warning above it. #}
{% extends office_layout() %}

{% block title %}{{ 'contact.title'|trans({}, 'office') }}{% endblock %}

{% block content %}
<section class="of-page of-contact">
    <header class="of-page-head"><h1>{{ 'contact.title'|trans({}, 'office') }}</h1></header>
    {% if sent %}
    <p class="of-success" role="status">{{ 'contact.sent'|trans({}, 'office') }}</p>
    {% else %}
    <div class="of-columns">
        <div>
            <p class="of-warning">{{ notice|trans|raw }}</p>
            {{ form_start(form, {attr: {class: 'of-form', novalidate: 'novalidate'}}) }}
                {{ form_row(form.name, {label: 'contact.name'|trans({}, 'office')}) }}
                {{ form_row(form.email, {label: 'contact.email'|trans({}, 'office')}) }}
                {{ form_row(form.phone, {label: 'contact.phone'|trans({}, 'office')}) }}
                {{ form_row(form.message, {label: 'contact.message'|trans({}, 'office')}) }}
                {{ form_row(form.website) }}
                {{ form_row(form.privacy) }}
                <button type="submit" class="of-button">{{ 'contact.submit'|trans({}, 'office') }}</button>
            {{ form_end(form) }}
        </div>
        {% if office %}
        <aside>
            <h2>{{ office.name }}</h2>
            <address class="of-address">{{ office.street }}<br>{{ office.postalCode }} {{ office.city }}</address>
            {% if office.phone %}<p><a class="of-phone" href="tel:{{ office.phone|replace({' ': ''}) }}">{{ office.phone }}</a></p>{% endif %}
            <p><a href="{{ path('office_hours') }}">{{ 'hours.title'|trans({}, 'office') }}</a></p>
        </aside>
        {% endif %}
    </div>
    {% endif %}
</section>
{% endblock %}
